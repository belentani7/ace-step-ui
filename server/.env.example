# ACE-Step UI Configuration

# Server
PORT=3001
NODE_ENV=development

# Database (SQLite)
DATABASE_PATH=./data/acestep.db

# ACE-Step API (local)
ACESTEP_API_URL=http://localhost:8001

# Storage
AUDIO_DIR=./public/audio

# Frontend
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001

# JWT session signing key: set a random value of at least 32 characters for persistent sessions.
# Example generation: openssl rand -hex 32
# If unset/weak, a fresh ephemeral key is generated at each server restart.
JWT_SECRET=

# Passwordless /api/auth/auto and /api/auth/setup are restricted to this machine.
# Setting this to true restores LAN bootstrap but allows anyone on your LAN to impersonate users.
# Never enable on a public-facing server.
ALLOW_LAN_SESSION_BOOTSTRAP=false

# Optional: Pexels API Key (for video backgrounds)
# Get a free API key at https://www.pexels.com/api/
PEXELS_API_KEY=
